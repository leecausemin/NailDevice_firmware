NRF_BLE_QWR_DEF(m_qwr);                                                             /**< Context for the Queued Write module.*/
BLE_ADVERTISING_DEF(m_advertising);                                                 /**< Advertising module instance. */

static uint16_t   m_conn_handle          = BLE_CONN_HANDLE_INVALID;                 /**< Handle of the current connection. */
static uint16_t   m_ble_nus_max_data_len = BLE_GATT_ATT_MTU_DEFAULT - 3;            /**< Maximum length of data (in bytes) that can be transmitted to the peer by the Nordic UART service module. */
static ble_uuid_t m_adv_uuids[]          =                                          /**< Universally unique service identifier. */
{
    {BLE_UUID_NUS_SERVICE, NUS_SERVICE_UUID_TYPE}
};

/* =====================================================================
 *  데이터 로거 (data logger)
 *  - PC가 's' 보내면 녹화 시작 -> 주기적으로 값을 버퍼에 쌓음
 *  - PC가 'e' 보내면 녹화 정지 -> 버퍼 전체를 BLE로 전송
 * ===================================================================== */
#define LOG_BUF_SIZE      1000    /**< 저장 가능한 최대 샘플 개수 (IMU 6축) */
#define SAMPLE_PERIOD_MS  100     /**< 샘플링 주기(ms). 100 = 초당 10개 */

/** IMU 한 샘플: 가속도 3축 + 자이로 3축 (각 16비트 원시값) */
typedef struct { int16_t ax, ay, az, gx, gy, gz; } imu_sample_t;

APP_TIMER_DEF(m_sample_timer);                    /**< 샘플링용 반복 타이머 */
static imu_sample_t  m_log_buf[LOG_BUF_SIZE];     /**< 데이터 버퍼(RAM) */
static uint32_t      m_log_count    = 0;          /**< 현재까지 쌓인 개수 */
static volatile bool m_recording    = false;      /**< 녹화 중 여부 */
static volatile bool m_dump_request = false;      /**< 메인 루프에 전송 요청 */
static volatile bool m_scan_request = false;      /**< 메인 루프에 센서 스캔 요청 */
static volatile bool m_sample_due   = false;      /**< 타이머가 세팅→메인루프가 샘플 읽음 */

/* =====================================================================
 *  BMI160 IMU (SPI 연결) - 배선: 사수님 코드와 동일
 * ===================================================================== */
#define BMI160_SCK_PIN     40    /**< SPI 클럭 */
#define BMI160_MOSI_PIN    39    /**< 데이터 출력(보드->센서) */
#define BMI160_MISO_PIN    37    /**< 데이터 입력(센서->보드) */
#define BMI160_CS_PIN      38    /**< 칩 선택(CS/SS) */

#define BMI160_REG_CHIP_ID 0x00  /**< CHIP_ID 레지스터 주소 */
#define BMI160_CHIP_ID_VAL 0xD1  /**< BMI160의 고정 ID 값 */
#define TPS_CTRL_PIN       23    /**< JY_TP_IMU 원본 보드 제어 핀 */
#define TPS_CTRL_PIN2      19    /**< JY_TP_IMU 원본 보드 제어 핀 2 */

static const nrf_drv_spi_t m_spi = NRF_DRV_SPI_INSTANCE(0);   /**< SPI 인스턴스 0 */

/**@brief 지정한 핀맵으로 SPI 초기화 */
static void bmi160_spi_init_pins(uint32_t sck, uint32_t mosi,
                                uint32_t miso, uint32_t cs)
{
    nrf_drv_spi_config_t cfg = NRF_DRV_SPI_DEFAULT_CONFIG;
    cfg.sck_pin   = sck;
    cfg.mosi_pin  = mosi;
    cfg.miso_pin  = miso;
    cfg.ss_pin    = cs;
    /* JY_Firmware의 실제 보드 설정과 동일: 8 MHz, SPI mode 3 */
    cfg.frequency = NRF_DRV_SPI_FREQ_8M;
    cfg.mode      = NRF_DRV_SPI_MODE_3;
    cfg.bit_order = NRF_DRV_SPI_BIT_ORDER_MSB_FIRST;

    ret_code_t err_code = nrf_drv_spi_init(&m_spi, &cfg, NULL, NULL);  // 블로킹 모드
    APP_ERROR_CHECK(err_code);
}

/**@brief BMI160 레지스터 1개 읽기 (SPI 읽기: 주소 최상위비트=1) */
static uint8_t bmi160_read_reg(uint8_t reg)
{
    uint8_t tx[2] = { (uint8_t)(reg | 0x80), 0x00 };
    uint8_t rx[2] = { 0, 0 };
    APP_ERROR_CHECK(nrf_drv_spi_transfer(&m_spi, tx, 2, rx, 2));
    return rx[1];   // 두 번째 바이트가 실제 레지스터 값
}

/**@brief HW 8.0 보드의 LSM6DSL을 전용 핀맵으로 검사한다.
 *
 * P0.14(TPS)는 보드 전원 극성이 확정되지 않았으므로 여기서는 절대 구동하지 않는다.
 * LSM6DSL은 SPI mode 0과 mode 3을 모두 지원하므로 기존 mode 3 인스턴스를 사용한다.
 */
/* GPIO open-drain 방식의 저속 I2C 탐색기. HIGH는 직접 출력하지 않는다. */
static uint32_t m_i2c_scl;
static uint32_t m_i2c_sda;

static void i2c_line_low(uint32_t pin)
{
    nrf_gpio_cfg_output(pin);
    nrf_gpio_pin_clear(pin);
}

static void i2c_line_release(uint32_t pin)
{
    nrf_gpio_cfg_input(pin, NRF_GPIO_PIN_PULLUP);
}

static void i2c_delay(void) { nrf_delay_us(5); }

static void i2c_start(void)
{
    i2c_line_release(m_i2c_sda);
    i2c_line_release(m_i2c_scl);
    i2c_delay();
    i2c_line_low(m_i2c_sda);
    i2c_delay();
    i2c_line_low(m_i2c_scl);
}

static void i2c_stop(void)
{
    i2c_line_low(m_i2c_sda);
    i2c_delay();
    i2c_line_release(m_i2c_scl);
    i2c_delay();
    i2c_line_release(m_i2c_sda);
    i2c_delay();
}

static bool i2c_write_byte(uint8_t value)
{
    for (uint8_t bit = 0; bit < 8; bit++)
    {
        if (value & 0x80) i2c_line_release(m_i2c_sda);
        else              i2c_line_low(m_i2c_sda);
        i2c_delay();
        i2c_line_release(m_i2c_scl);
        i2c_delay();
        i2c_line_low(m_i2c_scl);
        value <<= 1;
    }

    i2c_line_release(m_i2c_sda);
    i2c_delay();
    i2c_line_release(m_i2c_scl);
    i2c_delay();
    bool ack = (nrf_gpio_pin_read(m_i2c_sda) == 0);
    i2c_line_low(m_i2c_scl);
    return ack;
}

static uint8_t i2c_read_byte(void)
{
    uint8_t value = 0;
    i2c_line_release(m_i2c_sda);
    for (uint8_t bit = 0; bit < 8; bit++)
    {
        value <<= 1;
        i2c_line_release(m_i2c_scl);
        i2c_delay();
        if (nrf_gpio_pin_read(m_i2c_sda)) value |= 1;
        i2c_line_low(m_i2c_scl);
        i2c_delay();
    }
    i2c_line_release(m_i2c_sda); /* NACK */
    i2c_line_release(m_i2c_scl);
    i2c_delay();
    i2c_line_low(m_i2c_scl);
    return value;
}

static bool i2c_read_reg(uint8_t address, uint8_t reg, uint8_t *value)
{
    i2c_start();
    if (!i2c_write_byte((uint8_t)(address << 1)) || !i2c_write_byte(reg))
    {
        i2c_stop();
        return false;
    }
    i2c_start();
    if (!i2c_write_byte((uint8_t)((address << 1) | 1)))
    {
        i2c_stop();
        return false;
    }
    *value = i2c_read_byte();
    i2c_stop();
    return true;
}

static void __attribute__((unused)) lsm6dsl_i2c_probe(void)
{
    static const uint8_t pairs[][2] =
    {
        {17,13}, {13,17}, {27,15}, {15,27}, {27,26},
        {26,27}, {26,40}, {40,26}, {6,27},  {27,6}
    };

    nrf_gpio_cfg_output(14);
    nrf_gpio_pin_clear(14);

    for (uint32_t i = 0; i < sizeof(pairs) / sizeof(pairs[0]); i++)
    {
        m_i2c_scl = pairs[i][0];
        m_i2c_sda = pairs[i][1];
        i2c_line_release(m_i2c_scl);
        i2c_line_release(m_i2c_sda);

        for (uint8_t address = 0x6A; address <= 0x6B; address++)
        {
            uint8_t id = 0;
            if (i2c_read_reg(address, 0x0F, &id))
            {
                NRF_LOG_INFO("I2C ACK pair%u addr=0x%02X ID=0x%02X",
                             i, address, id);
                if (id == 0x6A)
                    NRF_LOG_INFO(">>> LSM6DSL FOUND by I2C pair%u", i);
            }
        }
    }
    NRF_LOG_INFO("I2C LSM6DSL scan finished");
}

static void lsm6dsl_spi_probe(void)
{
    typedef struct { uint8_t sck, mosi, miso; } spi_bus_t;
    static const spi_bus_t buses[] =
    {
        {17,13,15}, {17,15,13},
        {27,15, 6}, {27, 6,15},
        {27,26,40}, {27,40,26},
        {40,39,37}, {40,37,39}
    };
    static const uint8_t cs_pins[] = { 8, 19, 23, 25, 36, 38, 39, 43 };
    static const nrf_drv_spi_mode_t modes[] =
    {
        NRF_DRV_SPI_MODE_0, NRF_DRV_SPI_MODE_3
    };

    nrf_gpio_cfg_output(14);
    nrf_gpio_pin_clear(14);

    for (uint32_t b = 0; b < sizeof(buses) / sizeof(buses[0]); b++)
    {
        for (uint32_t c = 0; c < sizeof(cs_pins) / sizeof(cs_pins[0]); c++)
        {
            if (cs_pins[c] == buses[b].sck ||
                cs_pins[c] == buses[b].mosi ||
                cs_pins[c] == buses[b].miso)
                continue;

            for (uint32_t m = 0; m < sizeof(modes) / sizeof(modes[0]); m++)
            {
                nrf_drv_spi_config_t cfg = NRF_DRV_SPI_DEFAULT_CONFIG;
                cfg.sck_pin   = buses[b].sck;
                cfg.mosi_pin  = buses[b].mosi;
                cfg.miso_pin  = buses[b].miso;
                cfg.ss_pin    = cs_pins[c];
                cfg.frequency = NRF_DRV_SPI_FREQ_125K;
                cfg.mode      = modes[m];
                cfg.bit_order = NRF_DRV_SPI_BIT_ORDER_MSB_FIRST;

                ret_code_t err = nrf_drv_spi_init(&m_spi, &cfg, NULL, NULL);
                if (err != NRF_SUCCESS)
                    continue;
                nrf_delay_ms(2);

                (void)bmi160_read_reg(0x0F);
                uint8_t id = bmi160_read_reg(0x0F);
                if (id != 0x00 && id != 0xFF)
                {
                    NRF_LOG_INFO("SPI response bus%u CS=%u mode=%u ID=0x%02X",
                                 b, cs_pins[c], m, id);
                }
                if (id == 0x6A)
                {
                    NRF_LOG_INFO(">>> LSM6DSL FOUND: bus%u CS=%u mode=%u",
                                 b, cs_pins[c], m);
                    NRF_LOG_INFO("  SCK=%u MOSI=%u MISO=%u",
                                 buses[b].sck, buses[b].mosi, buses[b].miso);
                }
                nrf_drv_spi_uninit(&m_spi);
            }
        }
    }
    NRF_LOG_INFO("Restricted SPI LSM6DSL scan finished");
}

static void __attribute__((unused)) lsm6dsl_hw8_probe(void)
{
    /* EN14=HIGH에서 이 보드는 정지하므로 LOW 상태를 유지한다. */
    nrf_gpio_cfg_output(14);
    nrf_gpio_pin_clear(14);
    nrf_delay_ms(20);
    bmi160_spi_init_pins(27, 15, 6, 25);
    NRF_LOG_INFO("Nail probe safe state: EN14=LOW, WHO_AM_I=0x%02X",
                 bmi160_read_reg(0x0F));
}

/**@brief 전원이 켜진 실제 보드에서 JY_TP/BMI160 핀맵을 다시 검사한다. */
static void __attribute__((unused)) bmi160_jy_probe(void)
{
    bmi160_spi_init_pins(40, 39, 37, 38);
    nrf_delay_ms(20);

    /* BMI160은 첫 SPI read로 인터페이스가 SPI 모드로 전환될 수 있다. */
    (void)bmi160_read_reg(0x7F);
    nrf_delay_ms(2);
    NRF_LOG_INFO("JY BMI160 CHIP_ID=0x%02X (expected 0xD1)",
                 bmi160_read_reg(BMI160_REG_CHIP_ID));
}

/**@brief JY_TP_IMU 보드의 두 전원 제어 핀 조합을 실제 하드웨어에서 탐색 */
static void __attribute__((unused)) imu_power_probe(void)
{
    nrf_gpio_cfg_output(TPS_CTRL_PIN);
    nrf_gpio_cfg_output(TPS_CTRL_PIN2);

    for (uint8_t combo = 0; combo < 4; combo++)
    {
        nrf_gpio_pin_write(TPS_CTRL_PIN,  (combo >> 1) & 1);
        nrf_gpio_pin_write(TPS_CTRL_PIN2, combo & 1);
        nrf_delay_ms(100);

        /* 전원 재인가 후 첫 SPI 접근으로 BMI160을 SPI 모드로 전환 */
        (void)bmi160_read_reg(0x7F);
        nrf_delay_ms(2);

        uint8_t id = bmi160_read_reg(BMI160_REG_CHIP_ID);
        NRF_LOG_INFO("Power probe P0.23=%u P0.19=%u -> CHIP_ID=0x%02X",
                     (combo >> 1) & 1, combo & 1, id);

        if (id == BMI160_CHIP_ID_VAL)
        {
            NRF_LOG_INFO(">>> BMI160 power combination found");
            return; /* 검출된 전원 상태를 그대로 유지 */
        }
    }

    /* 원본 테스트 코드에서 사용하던 기본 비활성 상태로 복귀 */
    nrf_gpio_pin_clear(TPS_CTRL_PIN);
    nrf_gpio_pin_clear(TPS_CTRL_PIN2);
}

/**@brief 전달받은 펌웨어에서 발견된 IMU 핀맵들을 자동 검사 */
static void __attribute__((unused)) imu_pinmap_probe(void)
{
    typedef struct
    {
        const char *name;
        uint32_t cs;
        uint32_t sck;
        uint32_t mosi;
        uint32_t miso;
        uint32_t power_pin;
    } imu_map_t;

    static const imu_map_t maps[] =
    {
        { "JY_TP_IMU", 38, 40, 39, 37, 23 },
        { "HW8_MA",    25, 27, 15,  6, 14 }
    };

    for (uint32_t i = 0; i < sizeof(maps) / sizeof(maps[0]); i++)
    {
        nrf_gpio_cfg_output(maps[i].power_pin);

        for (uint8_t power = 0; power <= 1; power++)
        {
            nrf_gpio_pin_write(maps[i].power_pin, power);
            nrf_delay_ms(100);

            bmi160_spi_init_pins(maps[i].sck, maps[i].mosi,
                                 maps[i].miso, maps[i].cs);

            (void)bmi160_read_reg(0x7F);
            nrf_delay_ms(2);

            uint8_t bmi = bmi160_read_reg(0x00);
            uint8_t lsm = bmi160_read_reg(0x0F);
            NRF_LOG_INFO("Map %s power(P%u.%02u)=%u: reg00=0x%02X reg0F=0x%02X",
                         (uint32_t)maps[i].name,
                         maps[i].power_pin / 32, maps[i].power_pin % 32,
                         power, bmi, lsm);

            nrf_drv_spi_uninit(&m_spi);
        }

        nrf_gpio_pin_clear(maps[i].power_pin);
    }

    /* 이후 기존 검증 함수가 사용할 JY_TP_IMU 핀맵으로 복귀 */
    bmi160_spi_init_pins(BMI160_SCK_PIN, BMI160_MOSI_PIN,
                         BMI160_MISO_PIN, BMI160_CS_PIN);
}

/**@brief MISO 선이 전기적으로 살아있는지 GPIO로 확인 (SPI 초기화 전에 호출) */
static void __attribute__((unused)) imu_pin_test(void)
{
    nrf_gpio_cfg_input(BMI160_MISO_PIN, NRF_GPIO_PIN_PULLUP);
    nrf_delay_ms(1);
    uint32_t up = nrf_gpio_pin_read(BMI160_MISO_PIN);

    nrf_gpio_cfg_input(BMI160_MISO_PIN, NRF_GPIO_PIN_PULLDOWN);
    nrf_delay_ms(1);
    uint32_t down = nrf_gpio_pin_read(BMI160_MISO_PIN);

    nrf_gpio_cfg_input(BMI160_MISO_PIN, NRF_GPIO_PIN_NOPULL);  // 원상복구

    NRF_LOG_INFO("MISO(P1.05) test: pullup=%u, pulldown=%u", (unsigned)up, (unsigned)down);
    if (up == 1 && down == 0)
    {
        NRF_LOG_INFO("  -> MISO floating. 미연결/단선/센서 tri-state 모두 가능");
    }
    else if (up == 0 && down == 0)
    {
        NRF_LOG_INFO("  -> MISO가 계속 0 (GND에 묶임/미연결?). MISO 배선/핀 의심");
    }
    else
    {
        NRF_LOG_INFO("  -> MISO가 계속 1 (VCC에 묶임?). 배선 확인");
    }
}

/**@brief BMI160 통신 검증: CHIP_ID를 읽어 0xD1이 나오는지 확인 */
static void __attribute__((unused)) bmi160_verify(void)
{
    // BMI160은 전원 인가 시 I2C 모드 -> 첫 SPI 읽기(더미)로 SPI 모드 전환
    (void)bmi160_read_reg(0x7F);
    nrf_delay_ms(1);

    uint8_t bmi = bmi160_read_reg(0x00);   // BMI160 CHIP_ID   (기대 0xD1)
    uint8_t st  = bmi160_read_reg(0x0F);   // ST LSM6xxx WHO_AM_I (기대 0x6A/0x6C/0x69)

    NRF_LOG_INFO("IMU probe: reg0x00=0x%02X (BMI160=0xD1)  reg0x0F=0x%02X (LSM6=0x6A/6C)", bmi, st);

    if (bmi == 0xD1)
    {
        NRF_LOG_INFO(">>> BMI160 detected! (SPI OK)");
    }
    else if (st == 0x6A || st == 0x6C || st == 0x69)
    {
        NRF_LOG_INFO(">>> LSM6-series IMU detected! (SPI OK) -> LSM6 드라이버로 진행하면 됨");
    }
    else
    {
        NRF_LOG_WARNING(">>> 유효 ID 없음 (둘 다 죽음). 전원(VCC/GND)/CS/MISO 배선 확인 필요.");
    }

    // 앞쪽 레지스터 덤프 (통신이 살아있는지 육안 확인용)
    for (uint8_t r = 0; r < 8; r++)
    {
        NRF_LOG_INFO("  reg[0x%02X] = 0x%02X", r, bmi160_read_reg(r));
    }
}


/**@brief Function for assert macro callback.
 *
 * @details This function will be called in case of an assert in the SoftDevice.
 *
 * @warning This handler is an example only and does not fit a final product. You need to analyse
 *          how your product is supposed to react in case of Assert.
 * @warning On assert from the SoftDevice, the system can only recover on reset.
 *
 * @param[in] line_num    Line number of the failing ASSERT call.
 * @param[in] p_file_name File name of the failing ASSERT call.
 */
void assert_nrf_callback(uint16_t line_num, const uint8_t * p_file_name)
{
    app_error_handler(DEAD_BEEF, line_num, p_file_name);
}

/**@brief 샘플링 타이머 콜백 - 녹화 중이면 값 하나를 버퍼에 저장한다.
 *
 * @details 지금은 더미 카운터를 저장한다. 2단계에서 이 부분을 실제 센서값 읽기로 바꾸면 된다.
 */
static void sample_timer_handler(void * p_context)
{
    // ISR 컨텍스트에서는 비트뱅잉(블로킹)을 하지 않는다. 플래그만 세팅하고
    // 실제 센서 읽기는 메인 루프에서 수행한다(SoftDevice 타이밍 보호).
    if (m_recording)
    {
        m_sample_due = true;
    }
}

/**@brief Function for initializing the timer module.
 */
static void timers_init(void)
{
    ret_code_t err_code = app_timer_init();
    APP_ERROR_CHECK(err_code);

    // 샘플링용 반복 타이머 생성
    err_code = app_timer_create(&m_sample_timer, APP_TIMER_MODE_REPEATED, sample_timer_handler);
    APP_ERROR_CHECK(err_code);
}

/**@brief Function for the GAP initialization.
 *
 * @details This function will set up all the necessary GAP (Generic Access Profile) parameters of
 *          the device. It also sets the permissions and appearance.
 */
static void gap_params_init(void)
{
    uint32_t                err_code;
    ble_gap_conn_params_t   gap_conn_params;
    ble_gap_conn_sec_mode_t sec_mode;

    BLE_GAP_CONN_SEC_MODE_SET_OPEN(&sec_mode);

    err_code = sd_ble_gap_device_name_set(&sec_mode,
                                          (const uint8_t *) DEVICE_NAME,
                                          strlen(DEVICE_NAME));
    APP_ERROR_CHECK(err_code);

    memset(&gap_conn_params, 0, sizeof(gap_conn_params));

    gap_conn_params.min_conn_interval = MIN_CONN_INTERVAL;
    gap_conn_params.max_conn_interval = MAX_CONN_INTERVAL;
    gap_conn_params.slave_latency     = SLAVE_LATENCY;
    gap_conn_params.conn_sup_timeout  = CONN_SUP_TIMEOUT;

    err_code = sd_ble_gap_ppcp_set(&gap_conn_params);
    APP_ERROR_CHECK(err_code);
}


/**@brief Function for handling Queued Write Module errors.
 *
 * @details A pointer to this function will be passed to each service which may need to inform the
 *          application about an error.
 *
 * @param[in]   nrf_error   Error code containing information about what went wrong.
 */
static void nrf_qwr_error_handler(uint32_t nrf_error)
{
    APP_ERROR_HANDLER(nrf_error);
}


/**@brief Function for handling the data from the Nordic UART Service.
 *
 * @details This function will process the data received from the Nordic UART BLE Service and send
 *          it to the UART module.
 *
 * @param[in] p_evt       Nordic UART Service event.
 */
/**@snippet [Handling the data received over BLE] */
static void nus_data_handler(ble_nus_evt_t * p_evt)
{

    if (p_evt->type == BLE_NUS_EVT_RX_DATA)
    {
        // PC가 보낸 첫 바이트를 명령으로 해석한다.
        uint8_t cmd = p_evt->params.rx_data.p_data[0];

        if (cmd == 's' || cmd == 'S')          // ---- 녹화 시작 ----
        {
            m_log_count   = 0;
            m_recording   = true;

            ret_code_t err_code = app_timer_start(m_sample_timer,
                                                  APP_TIMER_TICKS(SAMPLE_PERIOD_MS),
                                                  NULL);
            APP_ERROR_CHECK(err_code);
            NRF_LOG_INFO("=> Recording STARTED");
        }
        else if (cmd == 'e' || cmd == 'E')     // ---- 녹화 정지 + 전송 ----
        {
            m_recording = false;
            app_timer_stop(m_sample_timer);
            m_dump_request = true;             // 실제 전송은 메인 루프에서 처리
            NRF_LOG_INFO("=> Recording STOPPED (%d samples). Will dump over BLE.", m_log_count);
        }
        else if (cmd == 'w' || cmd == 'W')     // ---- 센서 WHO_AM_I 스캔 ----
        {
            m_scan_request = true;             // 실제 스캔/전송은 메인 루프에서 처리
            NRF_LOG_INFO("=> Sensor scan requested. Will report over BLE.");
        }
    }

}
/**@snippet [Handling the data received over BLE] */


/**@brief Function for initializing services that will be used by the application.
 */
static void services_init(void)
{
    uint32_t           err_code;
    ble_nus_init_t     nus_init;
    nrf_ble_qwr_init_t qwr_init = {0};

    // Initialize Queued Write Module.
    qwr_init.error_handler = nrf_qwr_error_handler;

    err_code = nrf_ble_qwr_init(&m_qwr, &qwr_init);
    APP_ERROR_CHECK(err_code);

    // Initialize NUS.
    memset(&nus_init, 0, sizeof(nus_init));

    nus_init.data_handler = nus_data_handler;

    err_code = ble_nus_init(&m_nus, &nus_init);
    APP_ERROR_CHECK(err_code);
}


/**@brief Function for handling an event from the Connection Parameters Module.
 *
 * @details This function will be called for all events in the Connection Parameters Module
 *          which are passed to the application.
 *
 * @note All this function does is to disconnect. This could have been done by simply setting
 *       the disconnect_on_fail config parameter, but instead we use the event handler
 *       mechanism to demonstrate its use.
 *
 * @param[in] p_evt  Event received from the Connection Parameters Module.
 */
static void on_conn_params_evt(ble_conn_params_evt_t * p_evt)
{
    uint32_t err_code;

    if (p_evt->evt_type == BLE_CONN_PARAMS_EVT_FAILED)
    {
        err_code = sd_ble_gap_disconnect(m_conn_handle, BLE_HCI_CONN_INTERVAL_UNACCEPTABLE);
        APP_ERROR_CHECK(err_code);
    }
}


/**@brief Function for handling errors from the Connection Parameters module.
 *
 * @param[in] nrf_error  Error code containing information about what went wrong.
 */
static void conn_params_error_handler(uint32_t nrf_error)
{
    APP_ERROR_HANDLER(nrf_error);
}


/**@brief Function for initializing the Connection Parameters module.
 */
static void conn_params_init(void)
{
    uint32_t               err_code;
    ble_conn_params_init_t cp_init;

    memset(&cp_init, 0, sizeof(cp_init));

    cp_init.p_conn_params                  = NULL;
    cp_init.first_conn_params_update_delay = FIRST_CONN_PARAMS_UPDATE_DELAY;
    cp_init.next_conn_params_update_delay  = NEXT_CONN_PARAMS_UPDATE_DELAY;
    cp_init.max_conn_params_update_count   = MAX_CONN_PARAMS_UPDATE_COUNT;
    cp_init.start_on_notify_cccd_handle    = BLE_GATT_HANDLE_INVALID;
    cp_init.disconnect_on_fail             = false;
    cp_init.evt_handler                    = on_conn_params_evt;
    cp_init.error_handler                  = conn_params_error_handler;

    err_code = ble_conn_params_init(&cp_init);
    APP_ERROR_CHECK(err_code);
}


/**@brief Function for putting the chip into sleep mode.
 *
 * @note This function will not return.
 */
static void sleep_mode_enter(void)
{
    uint32_t err_code = bsp_indication_set(BSP_INDICATE_IDLE);
    APP_ERROR_CHECK(err_code);

    // Prepare wakeup buttons.
    err_code = bsp_btn_ble_sleep_mode_prepare();
    APP_ERROR_CHECK(err_code);

    // Go to system-off mode (this function will not return; wakeup will cause a reset).
    err_code = sd_power_system_off();
    APP_ERROR_CHECK(err_code);
}


/**@brief Function for handling advertising events.
 *
 * @details This function will be called for advertising events which are passed to the application.
 *
 * @param[in] ble_adv_evt  Advertising event.
 */
static void on_adv_evt(ble_adv_evt_t ble_adv_evt)
{
    uint32_t err_code;

    switch (ble_adv_evt)
    {
        case BLE_ADV_EVT_FAST:
            err_code = bsp_indication_set(BSP_INDICATE_ADVERTISING);
            APP_ERROR_CHECK(err_code);
            break;
        case BLE_ADV_EVT_IDLE:
            sleep_mode_enter();
            break;
        default:
            break;
    }
}


/**@brief Function for handling BLE events.
 *
 * @param[in]   p_ble_evt   Bluetooth stack event.
 * @param[in]   p_context   Unused.
 */
static void ble_evt_handler(ble_evt_t const * p_ble_evt, void * p_context)
{
    uint32_t err_code;

    switch (p_ble_evt->header.evt_id)
    {
        case BLE_GAP_EVT_CONNECTED:
            NRF_LOG_INFO("Connected");
            err_code = bsp_indication_set(BSP_INDICATE_CONNECTED);
            APP_ERROR_CHECK(err_code);
            m_conn_handle = p_ble_evt->evt.gap_evt.conn_handle;
            err_code = nrf_ble_qwr_conn_handle_assign(&m_qwr, m_conn_handle);
            APP_ERROR_CHECK(err_code);
            break;

        case BLE_GAP_EVT_DISCONNECTED:
            NRF_LOG_INFO("Disconnected");
            // LED indication will be changed when advertising starts.
            m_conn_handle = BLE_CONN_HANDLE_INVALID;
            break;

        case BLE_GAP_EVT_PHY_UPDATE_REQUEST:
        {
            NRF_LOG_DEBUG("PHY update request.");
            ble_gap_phys_t const phys =
            {
                .rx_phys = BLE_GAP_PHY_AUTO,
                .tx_phys = BLE_GAP_PHY_AUTO,
            };
            err_code = sd_ble_gap_phy_update(p_ble_evt->evt.gap_evt.conn_handle, &phys);
            APP_ERROR_CHECK(err_code);
        } break;

        case BLE_GAP_EVT_SEC_PARAMS_REQUEST:
            // Pairing not supported
            err_code = sd_ble_gap_sec_params_reply(m_conn_handle, BLE_GAP_SEC_STATUS_PAIRING_NOT_SUPP, NULL, NULL);
            APP_ERROR_CHECK(err_code);
            break;

        case BLE_GATTS_EVT_SYS_ATTR_MISSING:
            // No system attributes have been stored.
            err_code = sd_ble_gatts_sys_attr_set(m_conn_handle, NULL, 0, 0);
            APP_ERROR_CHECK(err_code);
            break;

        case BLE_GATTC_EVT_TIMEOUT:
            // Disconnect on GATT Client timeout event.
            err_code = sd_ble_gap_disconnect(p_ble_evt->evt.gattc_evt.conn_handle,
                                             BLE_HCI_REMOTE_USER_TERMINATED_CONNECTION);
            APP_ERROR_CHECK(err_code);
            break;

        case BLE_GATTS_EVT_TIMEOUT:
            // Disconnect on GATT Server timeout event.
            err_code = sd_ble_gap_disconnect(p_ble_evt->evt.gatts_evt.conn_handle,
                                             BLE_HCI_REMOTE_USER_TERMINATED_CONNECTION);
            APP_ERROR_CHECK(err_code);
            break;

        default:
            // No implementation needed.
            break;
    }
}


/**@brief Function for the SoftDevice initialization.
 *
 * @details This function initializes the SoftDevice and the BLE event interrupt.
 */
static void ble_stack_init(void)
{
    ret_code_t err_code;

    err_code = nrf_sdh_enable_request();
    APP_ERROR_CHECK(err_code);

    // Configure the BLE stack using the default settings.
    // Fetch the start address of the application RAM.
    uint32_t ram_start = 0;
    err_code = nrf_sdh_ble_default_cfg_set(APP_BLE_CONN_CFG_TAG, &ram_start);
    APP_ERROR_CHECK(err_code);

    // Enable BLE stack.
    err_code = nrf_sdh_ble_enable(&ram_start);
    APP_ERROR_CHECK(err_code);

    // Register a handler for BLE events.
    NRF_SDH_BLE_OBSERVER(m_ble_observer, APP_BLE_OBSERVER_PRIO, ble_evt_handler, NULL);
}


/**@brief Function for handling events from the GATT library. */
void gatt_evt_handler(nrf_ble_gatt_t * p_gatt, nrf_ble_gatt_evt_t const * p_evt)
{
    if ((m_conn_handle == p_evt->conn_handle) && (p_evt->evt_id == NRF_BLE_GATT_EVT_ATT_MTU_UPDATED))
    {
        m_ble_nus_max_data_len = p_evt->params.att_mtu_effective - OPCODE_LENGTH - HANDLE_LENGTH;
        NRF_LOG_INFO("Data len is set to 0x%X(%d)", m_ble_nus_max_data_len, m_ble_nus_max_data_len);
    }
    NRF_LOG_DEBUG("ATT MTU exchange completed. central 0x%x peripheral 0x%x",
                  p_gatt->att_mtu_desired_central,
                  p_gatt->att_mtu_desired_periph);
}


/**@brief Function for initializing the GATT library. */
void gatt_init(void)
{
    ret_code_t err_code;

    err_code = nrf_ble_gatt_init(&m_gatt, gatt_evt_handler);
    APP_ERROR_CHECK(err_code);

    err_code = nrf_ble_gatt_att_mtu_periph_set(&m_gatt, NRF_SDH_BLE_GATT_MAX_MTU_SIZE);
    APP_ERROR_CHECK(err_code);
}


/**@brief Function for handling events from the BSP module.
 *
 * @param[in]   event   Event generated by button press.
 */
void bsp_event_handler(bsp_event_t event)
{
    uint32_t err_code;
    switch (event)
    {
        case BSP_EVENT_SLEEP:
            sleep_mode_enter();
            break;

        case BSP_EVENT_DISCONNECT:
            err_code = sd_ble_gap_disconnect(m_conn_handle, BLE_HCI_REMOTE_USER_TERMINATED_CONNECTION);
            if (err_code != NRF_ERROR_INVALID_STATE)
            {
                APP_ERROR_CHECK(err_code);
            }
            break;

        case BSP_EVENT_WHITELIST_OFF:
            if (m_conn_handle == BLE_CONN_HANDLE_INVALID)
            {
                err_code = ble_advertising_restart_without_whitelist(&m_advertising);
                if (err_code != NRF_ERROR_INVALID_STATE)
                {
                    APP_ERROR_CHECK(err_code);
                }
            }
            break;

        default:
            break;
    }
}


/**@brief   Function for handling app_uart events.
 *
 * @details This function will receive a single character from the app_uart module and append it to
 *          a string. The string will be be sent over BLE when the last character received was a
 *          'new line' '\n' (hex 0x0A) or if the string has reached the maximum data length.
 */
/**@snippet [Handling the data received over UART] */
void uart_event_handle(app_uart_evt_t * p_event)
{
    static uint8_t data_array[BLE_NUS_MAX_DATA_LEN];
    static uint8_t index = 0;
    uint32_t       err_code;

    switch (p_event->evt_type)
    {
        case APP_UART_DATA_READY:
            UNUSED_VARIABLE(app_uart_get(&data_array[index]));
            index++;

            if ((data_array[index - 1] == '\n') ||
                (data_array[index - 1] == '\r') ||
                (index >= m_ble_nus_max_data_len))
            {
                if (index > 1)
                {
                    NRF_LOG_DEBUG("Ready to send data over BLE NUS");
                    NRF_LOG_HEXDUMP_DEBUG(data_array, index);

                    do
                    {
                        uint16_t length = (uint16_t)index;
                        err_code = ble_nus_data_send(&m_nus, data_array, &length, m_conn_handle);
                        if ((err_code != NRF_ERROR_INVALID_STATE) &&
                            (err_code != NRF_ERROR_RESOURCES) &&
                            (err_code != NRF_ERROR_NOT_FOUND))
                        {
                            APP_ERROR_CHECK(err_code);
                        }
                    } while (err_code == NRF_ERROR_RESOURCES);
                }

                index = 0;
            }
            break;

        case APP_UART_COMMUNICATION_ERROR:
            // 부팅 시 UART RX 라인의 프레이밍/브레이크 에러로 앱이 죽는 것을 방지.
            // 우리는 UART가 아니라 BLE만 사용하므로, 통신 에러는 무시하고 로그만 남긴다.
            NRF_LOG_WARNING("UART comm error 0x%x (ignored)", p_event->data.error_communication);
            break;

        case APP_UART_FIFO_ERROR:
            APP_ERROR_HANDLER(p_event->data.error_code);
            break;

        default:
            break;
    }
}
/**@snippet [Handling the data received over UART] */


/**@brief  Function for initializing the UART module.
 */
/**@snippet [UART Initialization] */
static void uart_init(void)
{
    uint32_t                     err_code;
    app_uart_comm_params_t const comm_params =
    {
        .rx_pin_no    = RX_PIN_NUMBER,
        .tx_pin_no    = TX_PIN_NUMBER,
        .rts_pin_no   = RTS_PIN_NUMBER,
        .cts_pin_no   = CTS_PIN_NUMBER,
        .flow_control = APP_UART_FLOW_CONTROL_DISABLED,
        .use_parity   = false,
#if defined (UART_PRESENT)
        .baud_rate    = NRF_UART_BAUDRATE_115200
#else
        .baud_rate    = NRF_UARTE_BAUDRATE_115200
#endif
    };

    APP_UART_FIFO_INIT(&comm_params,
                       UART_RX_BUF_SIZE,
                       UART_TX_BUF_SIZE,
                       uart_event_handle,
                       APP_IRQ_PRIORITY_LOWEST,
                       err_code);
    APP_ERROR_CHECK(err_code);
}
/**@snippet [UART Initialization] */


/**@brief Function for initializing the Advertising functionality.
 */
static void advertising_init(void)
{
    uint32_t               err_code;
    ble_advertising_init_t init;

    memset(&init, 0, sizeof(init));

    init.advdata.name_type          = BLE_ADVDATA_FULL_NAME;
    init.advdata.include_appearance = false;
    init.advdata.flags              = BLE_GAP_ADV_FLAGS_LE_ONLY_LIMITED_DISC_MODE;

    init.srdata.uuids_complete.uuid_cnt = sizeof(m_adv_uuids) / sizeof(m_adv_uuids[0]);
    init.srdata.uuids_complete.p_uuids  = m_adv_uuids;

    init.config.ble_adv_fast_enabled  = true;
    init.config.ble_adv_fast_interval = APP_ADV_INTERVAL;
    init.config.ble_adv_fast_timeout  = APP_ADV_DURATION;
    init.evt_handler = on_adv_evt;

    err_code = ble_advertising_init(&m_advertising, &init);
    APP_ERROR_CHECK(err_code);

    ble_advertising_conn_cfg_tag_set(&m_advertising, APP_BLE_CONN_CFG_TAG);
}


/**@brief Function for initializing buttons and leds.
 *
 * @param[out] p_erase_bonds  Will be true if the clear bonding button was pressed to wake the application up.
 */
static void buttons_leds_init(bool * p_erase_bonds)
{
    bsp_event_t startup_event;

    uint32_t err_code = bsp_init(BSP_INIT_LEDS | BSP_INIT_BUTTONS, bsp_event_handler);
    APP_ERROR_CHECK(err_code);

    err_code = bsp_btn_ble_init(NULL, &startup_event);
    APP_ERROR_CHECK(err_code);

    *p_erase_bonds = (startup_event == BSP_EVENT_CLEAR_BONDING_DATA);
}


/**@brief Function for initializing the nrf log module.
 */
static void log_init(void)
{
    ret_code_t err_code = NRF_LOG_INIT(NULL);
    APP_ERROR_CHECK(err_code);

    NRF_LOG_DEFAULT_BACKENDS_INIT();
}


/**@brief Function for initializing power management.
 */
static void power_management_init(void)
{
    ret_code_t err_code;
    err_code = nrf_pwr_mgmt_init();
    APP_ERROR_CHECK(err_code);
}


/**@brief Function for handling the idle state (main loop).
 *
 * @details If there is no pending log operation, then sleep until next the next event occurs.
 */
static void idle_state_handle(void)
{
    if (NRF_LOG_PROCESS() == false)
    {
        nrf_pwr_mgmt_run();
    }
}


/**@brief 버퍼에 쌓인 데이터를 BLE로 전부 전송한다. (정지 신호 시 메인 루프에서 호출)
 *
 * @details "인덱스,값" 형식으로 한 줄씩 보내고, 끝나면 "END"를 보낸다.
 *          BLE 송신 버퍼가 꽉 차면(NRF_ERROR_RESOURCES) 잠깐 쉬었다가 재전송한다.
 */
static void log_dump_over_ble(void)
{
    if (m_conn_handle == BLE_CONN_HANDLE_INVALID)
    {
        NRF_LOG_WARNING("Not connected - cannot dump.");
        return;
    }

    NRF_LOG_INFO("Dumping %d samples over BLE...", m_log_count);

    for (uint32_t i = 0; i < m_log_count; i++)
    {
        const imu_sample_t *s = &m_log_buf[i];
        char       line[56];
        int        slen = snprintf(line, sizeof(line), "%lu,%d,%d,%d,%d,%d,%d\n",
                                   (unsigned long)i,
                                   s->ax, s->ay, s->az, s->gx, s->gy, s->gz);
        ret_code_t err_code;

        do
        {
            uint16_t length = (uint16_t)slen;
            err_code = ble_nus_data_send(&m_nus, (uint8_t *)line, &length, m_conn_handle);

            if (err_code == NRF_ERROR_RESOURCES)
            {
                idle_state_handle();   // 송신 버퍼가 비워질 때까지 잠깐 대기
            }
            else if ((err_code != NRF_SUCCESS) &&
                     (err_code != NRF_ERROR_INVALID_STATE) &&
                     (err_code != NRF_ERROR_NOT_FOUND))
            {
                APP_ERROR_CHECK(err_code);
            }
        } while (err_code == NRF_ERROR_RESOURCES);
    }

    // 전송 완료 표시
    const char *end_marker = "END\n";
    ret_code_t  err_code;
    do
    {
        uint16_t length = 4;
        err_code = ble_nus_data_send(&m_nus, (uint8_t *)end_marker, &length, m_conn_handle);
        if (err_code == NRF_ERROR_RESOURCES)
        {
            idle_state_handle();
        }
    } while (err_code == NRF_ERROR_RESOURCES);

    NRF_LOG_INFO("Dump complete.");
}


/**@brief Function for starting advertising.
 */
static void advertising_start(void)
{
    uint32_t err_code = ble_advertising_start(&m_advertising, BLE_ADV_MODE_FAST);
    APP_ERROR_CHECK(err_code);
}


/**@brief Application main function.
 */
/**@brief LSM6DSL 최종 검증: 센서 전원 ON + 확정 핀맵(27/15/6/25) + WHO_AM_I 읽기.
 *
 * 이전 실패 원인 가설: (1) P0.14 전원을 안 켬  (2) UART/LED가 센서 핀 점유.
 * 이 함수는 UART를 끈 상태(main에서 uart_init 제거)에서, 전원을 켜고 직접 읽는다.
 */
static void lsm6_final_test(void)
{
    // 1) 센서 전원 ON (TPS LDO enable = P0.14 HIGH)
    nrf_gpio_cfg_output(14);
    nrf_gpio_pin_set(14);
    nrf_delay_ms(100);            // 전원 안정화 + 센서 부팅
    NRF_LOG_INFO("[LSM6] Sensor power P0.14 = HIGH");

    // 2) 확정 핀맵으로 WHO_AM_I(0x0F) 읽기 - mode 3, mode 0 둘 다 시도
    const nrf_drv_spi_mode_t modes[2] = { NRF_DRV_SPI_MODE_3, NRF_DRV_SPI_MODE_0 };
    for (int i = 0; i < 2; i++)
    {
        int mode_label = (modes[i] == NRF_DRV_SPI_MODE_3) ? 3 : 0;

        nrf_drv_spi_config_t cfg = NRF_DRV_SPI_DEFAULT_CONFIG;
        cfg.sck_pin   = 27;
        cfg.mosi_pin  = 15;
        cfg.miso_pin  = 6;
        cfg.ss_pin    = 25;
        cfg.frequency = NRF_DRV_SPI_FREQ_1M;
        cfg.mode      = modes[i];
        cfg.bit_order = NRF_DRV_SPI_BIT_ORDER_MSB_FIRST;

        if (nrf_drv_spi_init(&m_spi, &cfg, NULL, NULL) != NRF_SUCCESS)
        {
            NRF_LOG_ERROR("[LSM6] SPI init 실패 (mode %d)", mode_label);
            continue;
        }

        uint8_t tx[2] = { 0x0F | 0x80, 0x00 };   // WHO_AM_I 읽기
        uint8_t rx[2] = { 0, 0 };
        (void)nrf_drv_spi_transfer(&m_spi, tx, 2, rx, 2);   // 더미(SPI 안정화)
        nrf_delay_ms(1);
        nrf_drv_spi_transfer(&m_spi, tx, 2, rx, 2);

        NRF_LOG_INFO("[LSM6] mode%d WHO_AM_I(0x0F) = 0x%02X (expect 0x6A)", mode_label, rx[1]);
        if (rx[1] == 0x6A)
        {
            NRF_LOG_INFO(">>> [LSM6] LSM6DSL FOUND! (mode %d) 배선/전원 정답!", mode_label);
        }

        nrf_drv_spi_uninit(&m_spi);
        nrf_delay_ms(2);
    }
}

static void ble_send_str(const char *s);   // 전방 선언 (아래에서 정의)

/**@brief SPI 전송 완료 인터럽트 플래그 (타임아웃 대기용) */
static volatile bool m_spi_xfer_done = false;
static void spi_evt_handler(nrf_drv_spi_evt_t const * p_event, void * p_context)
{
    m_spi_xfer_done = true;
}

/**@brief 주어진 핀맵/모드로 LSM6DSL WHO_AM_I(0x0F) 한 번 읽기.
 * 전송이 끝나지 않아도 최대 ~200ms 후 포기하므로 절대 멈추지 않는다.
 * 반환: 정상=레지스터값, 0xEE=init실패, 0xED=전송시작실패, 0xDD=타임아웃 */
static uint8_t spi_read_whoami(uint32_t sck, uint32_t mosi, uint32_t miso,
                               uint32_t cs, nrf_drv_spi_mode_t mode)
{
    nrf_drv_spi_config_t cfg = NRF_DRV_SPI_DEFAULT_CONFIG;
    cfg.sck_pin   = sck;
    cfg.mosi_pin  = mosi;
    cfg.miso_pin  = miso;
    cfg.ss_pin    = cs;
    cfg.frequency = NRF_DRV_SPI_FREQ_125K;
    cfg.mode      = mode;
    cfg.bit_order = NRF_DRV_SPI_BIT_ORDER_MSB_FIRST;

    // 완료 핸들러 지정 = 비블로킹 모드 (전송은 인터럽트로 완료 통지)
    ret_code_t ic = nrf_drv_spi_init(&m_spi, &cfg, spi_evt_handler, NULL);
    ble_send_str("  ~init done\n");   // [진단] init에서 안 멈췄음
    if (ic != NRF_SUCCESS)
    {
        return 0xEE;   // init 실패 표시
    }

    uint8_t tx[2] = { 0x0F | 0x80, 0x00 };   // WHO_AM_I 읽기 명령(0x0F|0x80)
    uint8_t rx[2] = { 0, 0 };

    m_spi_xfer_done = false;
    ret_code_t tc = nrf_drv_spi_transfer(&m_spi, tx, 2, rx, 2);
    ble_send_str("  ~xfer started\n");   // [진단] 전송 시작에서 안 멈췄음
    if (tc != NRF_SUCCESS)
    {
        nrf_drv_spi_uninit(&m_spi);
        return 0xED;   // 전송 시작 실패
    }

    // 최대 200ms 타임아웃 대기 (안 끝나면 포기 → 무한대기 방지)
    uint32_t guard = 0;
    while (!m_spi_xfer_done && guard < 200)
    {
        nrf_delay_ms(1);
        guard++;
    }

    char dbg[40];
    snprintf(dbg, sizeof(dbg), "  ~wait exit done=%d g=%lu\n",
             (int)m_spi_xfer_done, (unsigned long)guard);
    ble_send_str(dbg);   // [진단] 대기 루프는 빠져나옴 (uninit 직전)

    nrf_drv_spi_uninit(&m_spi);
    ble_send_str("  ~uninit done\n");   // [진단] uninit도 통과
    return m_spi_xfer_done ? rx[1] : 0xDD;   // 0xDD = 타임아웃
}

/**@brief 센서 전원 ON 후, 문서상 후보 핀맵들을 하나씩 자동 시도한다. */
static void lsm6_scan(void)
{
    // 센서 전원 ON (사수 firmware 실측값 = P0.23)
    nrf_gpio_cfg_output(23);
    nrf_gpio_pin_set(23);
    nrf_delay_ms(150);
    NRF_LOG_INFO("[SCAN] power P0.23=HIGH, WHO_AM_I 기대값=0x6A");

    // 사수님 코드에 등장한 후보 핀맵 조합 (SCK, MOSI, MISO, CS)
    static const uint8_t cfgs[][4] =
    {
        {40, 39, 37, 38},   // JY main.c (power23과 짝) - 최우선
        {40, 37, 39, 38},   // 위의 MOSI/MISO swap
        {27, 15,  6, 25},   // app_config 기본
        {27,  6, 15, 25},   // app_config swap
        {17, 13, 15, 19},   // 구형 리비전 주석
    };

    for (int c = 0; c < 5; c++)
    {
        for (int m = 0; m < 2; m++)
        {
            nrf_drv_spi_mode_t mode = (m == 0) ? NRF_DRV_SPI_MODE_3 : NRF_DRV_SPI_MODE_0;
            uint8_t id = spi_read_whoami(cfgs[c][0], cfgs[c][1], cfgs[c][2], cfgs[c][3], mode);
            NRF_LOG_INFO("[SCAN] SCK%u MOSI%u MISO%u CS%u m%d = 0x%02X",
                         cfgs[c][0], cfgs[c][1], cfgs[c][2], cfgs[c][3], (m == 0) ? 3 : 0, id);
            if (id == 0x6A)
            {
                NRF_LOG_INFO(">>> [SCAN] LSM6DSL FOUND! (바로 위 조합)");
            }
            nrf_delay_ms(5);
        }
    }
    NRF_LOG_INFO("[SCAN] 완료");
}

/**@brief NUS TX로 문자열 한 줄 전송 (송신버퍼가 찰 때까지 대기). */
static void ble_send_str(const char *s)
{
    if (m_conn_handle == BLE_CONN_HANDLE_INVALID)
    {
        return;
    }

    uint16_t   len = (uint16_t)strlen(s);
    ret_code_t err_code;
    do
    {
        uint16_t length = len;
        err_code = ble_nus_data_send(&m_nus, (uint8_t *)s, &length, m_conn_handle);

        if (err_code == NRF_ERROR_RESOURCES)
        {
            idle_state_handle();   // 송신 버퍼가 비워질 때까지 잠깐 대기
        }
        else if ((err_code != NRF_SUCCESS) &&
                 (err_code != NRF_ERROR_INVALID_STATE) &&
                 (err_code != NRF_ERROR_NOT_FOUND))
        {
            APP_ERROR_CHECK(err_code);
        }
    } while (err_code == NRF_ERROR_RESOURCES);
}

/**@brief 소프트웨어 비트뱅잉 SPI (SPI mode 0): 1바이트 송수신.
 * GPIO 토글만 하므로 절대 멈추지 않는다(SPIM 하드웨어 블록 우회). */
// mode3: CPOL=1(클럭 idle HIGH), CPHA=1(2번째=상승 에지에서 샘플)
static uint8_t bb_txrx(uint32_t sck, uint32_t mosi, uint32_t miso, uint8_t out, int mode3)
{
    uint8_t in = 0;
    for (int i = 7; i >= 0; i--)
    {
        if (mode3)
        {
            nrf_gpio_pin_clear(sck);                 // 1번째 에지(하강): 데이터 세팅
            nrf_gpio_pin_write(mosi, (out >> i) & 1);
            nrf_delay_us(5);
            nrf_gpio_pin_set(sck);                   // 2번째 에지(상승): 샘플
            nrf_delay_us(5);
            if (nrf_gpio_pin_read(miso)) in |= (1 << i);
        }
        else
        {
            nrf_gpio_pin_write(mosi, (out >> i) & 1); // mode0: idle LOW
            nrf_delay_us(5);
            nrf_gpio_pin_set(sck);                    // 상승 에지: 샘플
            nrf_delay_us(5);
            if (nrf_gpio_pin_read(miso)) in |= (1 << i);
            nrf_gpio_pin_clear(sck);
            nrf_delay_us(5);
        }
    }
    return in;
}

/**@brief 비트뱅잉으로 LSM6DSL WHO_AM_I(0x0F) 읽기. CS active-low. */
static uint8_t bitbang_whoami(uint32_t sck, uint32_t mosi, uint32_t miso, uint32_t cs, int mode3)
{
    nrf_gpio_cfg_output(sck);
    nrf_gpio_cfg_output(mosi);
    nrf_gpio_cfg_output(cs);
    nrf_gpio_cfg_input(miso, NRF_GPIO_PIN_NOPULL);

    nrf_gpio_pin_write(sck, mode3 ? 1 : 0);   // idle: mode3=HIGH, mode0=LOW
    nrf_gpio_pin_set(cs);                      // CS 비활성(HIGH)
    nrf_delay_us(20);

    nrf_gpio_pin_clear(cs);                    // CS 활성(LOW)
    nrf_delay_us(5);
    (void)bb_txrx(sck, mosi, miso, 0x0F | 0x80, mode3);   // 읽기 명령 (0x8F)
    uint8_t v = bb_txrx(sck, mosi, miso, 0x00, mode3);    // WHO_AM_I 값
    nrf_gpio_pin_set(cs);                      // CS 비활성
    nrf_gpio_pin_write(sck, mode3 ? 1 : 0);    // idle 복귀

    return v;
}

/* =====================================================================
 *  LSM6DSL IMU 드라이버 (비트뱅잉 SPI mode3) — 핀맵 확정 (2026-07-20)
 *  SCK=P0.03, MOSI=P0.05, MISO=P0.06, CS=P0.02, 전원=P0.23
 *  (교수님 JY_full_merged.hex 디스어셈블로 확정, WHO_AM_I=0x6A 검증됨)
 * ===================================================================== */
#define IMU_SCK   3
#define IMU_MOSI  5
#define IMU_MISO  6
#define IMU_CS    2
#define IMU_PWR   23

#define LSM6_WHO_AM_I  0x0F
#define LSM6_CTRL1_XL  0x10   /**< 가속도 ODR/FS */
#define LSM6_CTRL2_G   0x11   /**< 자이로 ODR/FS */
#define LSM6_CTRL3_C   0x12   /**< BDU/IF_INC/SW_RESET */
#define LSM6_OUTX_L_G  0x22   /**< 자이로X_L .. (0x22~0x2D: 자이로6 + 가속도6, 자동증가) */
#define LSM6_WHO_AM_I_VAL 0x6A

/**@brief IMU 고정 핀 초기화 + 전원 ON (mode3: SCK idle HIGH, CS active-low) */
static void lsm6_pins_init(void)
{
    nrf_gpio_cfg_output(IMU_PWR);
    nrf_gpio_pin_set(IMU_PWR);                        // 센서 전원 ON
    nrf_gpio_cfg_output(IMU_SCK);
    nrf_gpio_cfg_output(IMU_MOSI);
    nrf_gpio_cfg_output(IMU_CS);
    nrf_gpio_cfg_input(IMU_MISO, NRF_GPIO_PIN_NOPULL);
    nrf_gpio_pin_set(IMU_SCK);                        // mode3 idle HIGH
    nrf_gpio_pin_set(IMU_CS);                         // CS 비활성
}

/**@brief 레지스터 1개 쓰기 (write: 최상위 비트=0) */
static void lsm6_write_reg(uint8_t reg, uint8_t val)
{
    nrf_gpio_pin_clear(IMU_CS);
    nrf_delay_us(2);
    (void)bb_txrx(IMU_SCK, IMU_MOSI, IMU_MISO, reg & 0x7F, 1);
    (void)bb_txrx(IMU_SCK, IMU_MOSI, IMU_MISO, val,        1);
    nrf_gpio_pin_set(IMU_CS);
    nrf_delay_us(2);
}

/**@brief 레지스터 1개 읽기 (read: 최상위 비트=1) */
static uint8_t lsm6_read_reg(uint8_t reg)
{
    nrf_gpio_pin_clear(IMU_CS);
    nrf_delay_us(2);
    (void)bb_txrx(IMU_SCK, IMU_MOSI, IMU_MISO, reg | 0x80, 1);
    uint8_t v = bb_txrx(IMU_SCK, IMU_MOSI, IMU_MISO, 0x00, 1);
    nrf_gpio_pin_set(IMU_CS);
    nrf_delay_us(2);
    return v;
}

/**@brief 연속 레지스터 읽기 (IF_INC 자동증가 이용) */
static void lsm6_read_multi(uint8_t reg, uint8_t *buf, int n)
{
    nrf_gpio_pin_clear(IMU_CS);
    nrf_delay_us(2);
    (void)bb_txrx(IMU_SCK, IMU_MOSI, IMU_MISO, reg | 0x80, 1);
    for (int i = 0; i < n; i++)
        buf[i] = bb_txrx(IMU_SCK, IMU_MOSI, IMU_MISO, 0x00, 1);
    nrf_gpio_pin_set(IMU_CS);
    nrf_delay_us(2);
}

/**@brief IMU 초기화: 전원+핀, WHO_AM_I 확인, ODR/범위 설정. 성공 시 true. */
static bool lsm6_init(void)
{
    lsm6_pins_init();
    nrf_delay_ms(50);                       // 전원/부팅 안정화

    uint8_t id = lsm6_read_reg(LSM6_WHO_AM_I);
    if (id != LSM6_WHO_AM_I_VAL)
    {
        NRF_LOG_WARNING("LSM6DSL not found (WHO_AM_I=0x%02X, expect 0x6A)", id);
        return false;
    }

    lsm6_write_reg(LSM6_CTRL3_C, 0x01);     // SW_RESET
    nrf_delay_ms(20);
    lsm6_write_reg(LSM6_CTRL3_C, 0x44);     // BDU=1, IF_INC=1
    lsm6_write_reg(LSM6_CTRL1_XL, 0x40);    // 가속도 104Hz, ±2g
    lsm6_write_reg(LSM6_CTRL2_G,  0x40);    // 자이로 104Hz, 245dps
    NRF_LOG_INFO("LSM6DSL init OK (WHO_AM_I=0x6A)");
    return true;
}

/**@brief 가속도 3축 + 자이로 3축 한 샘플 읽기 */
static void lsm6_read_sample(imu_sample_t *s)
{
    uint8_t b[12];
    lsm6_read_multi(LSM6_OUTX_L_G, b, 12);  // 0x22~0x2D = 자이로6 + 가속도6
    s->gx = (int16_t)(b[0]  | (b[1]  << 8));
    s->gy = (int16_t)(b[2]  | (b[3]  << 8));
    s->gz = (int16_t)(b[4]  | (b[5]  << 8));
    s->ax = (int16_t)(b[6]  | (b[7]  << 8));
    s->ay = (int16_t)(b[8]  | (b[9]  << 8));
    s->az = (int16_t)(b[10] | (b[11] << 8));
}

/**@brief 센서 WHO_AM_I 스캔을 실행하고 결과를 BLE(NUS)로 전송한다. (PC가 'w' 명령) */
static void scan_dump_over_ble(void)
{
    if (m_conn_handle == BLE_CONN_HANDLE_INVALID)
    {
        NRF_LOG_WARNING("Not connected - cannot scan.");
        return;
    }

    // 센서 전원 ON (사수 firmware 실측값 = P0.23)
    nrf_gpio_cfg_output(23);
    nrf_gpio_pin_set(23);
    nrf_delay_ms(150);
    ble_send_str("SCAN start (power P0.23=HIGH, expect WHO_AM_I=0x6A)\n");

    // 후보 핀맵 조합 (SCK, MOSI, MISO, CS)
    // {3,5,6,2}는 JY_full_merged.hex 디스어셈블 실측값(정답 유력)인데
    // 이 조합에서 SPI 전송이 멈추는 현상이 있어 맨 뒤에 두고, 각 시도 전에
    // "try..." 줄을 먼저 보내 어디서 멈추는지 확인한다.
    static const uint8_t cfgs[][4] =
    {
        {27, 15,  6, 25},   // app_config 기본 (완료 확인됨)
        {40, 39, 37, 38},   // JY main.c (구 가설)
        { 3,  5,  6,  2},   // JY hex 실측 - 정답 유력
    };
    const int n_cfgs = sizeof(cfgs) / sizeof(cfgs[0]);

    for (int c = 0; c < n_cfgs; c++)
    {
        for (int m3 = 0; m3 < 2; m3++)   // mode0, mode3 둘 다 시도
        {
            // 비트뱅잉(GPIO 수동 토글) — SPIM 하드웨어 우회, 절대 안 멈춤
            uint8_t id = bitbang_whoami(cfgs[c][0], cfgs[c][1], cfgs[c][2], cfgs[c][3], m3);

            char line[72];
            snprintf(line, sizeof(line),
                     "SCK%u MOSI%u MISO%u CS%u m%d(bb) = 0x%02X%s\n",
                     cfgs[c][0], cfgs[c][1], cfgs[c][2], cfgs[c][3],
                     m3 ? 3 : 0, id,
                     (id == 0x6A) ? "  <<< FOUND!" : "");
            ble_send_str(line);
            nrf_delay_ms(5);
        }
    }
    ble_send_str("END\n");
}

/**@brief SPI 핀은 문서값(27/15/6/25)으로 고정하고, 전원 enable 핀을 스캔한다.
 *
 * 각 후보 핀을 HIGH/LOW로 구동해 보며 WHO_AM_I=0x6A가 나오는지 확인.
 * (dangerous 핀 제외: SWD, RESET P0.18, NFC P0.09/10, 32k XTAL P0.00/01)
 */
static void lsm6_power_scan(void)
{
    // ISP1807에 노출된 안전한 P0 후보 (SPI 핀 27/15/6/25 제외)
    static const uint8_t pwr[] =
        { 14, 26, 16, 13, 8, 4, 5, 7, 11, 12, 17, 20, 21, 22, 24, 31 };

    NRF_LOG_INFO("[PWR] SPI 고정=27/15/6/25(mode3), 전원핀+극성 스캔 시작");

    for (int i = 0; i < (int)sizeof(pwr); i++)
    {
        uint8_t P = pwr[i];

        nrf_gpio_cfg_output(P);
        nrf_gpio_pin_set(P);                 // HIGH 시도
        nrf_delay_ms(120);
        uint8_t idH = spi_read_whoami(27, 15, 6, 25, NRF_DRV_SPI_MODE_3);

        nrf_gpio_pin_clear(P);               // LOW 시도
        nrf_delay_ms(120);
        uint8_t idL = spi_read_whoami(27, 15, 6, 25, NRF_DRV_SPI_MODE_3);

        nrf_gpio_cfg_input(P, NRF_GPIO_PIN_NOPULL);   // 원상복구

        NRF_LOG_INFO("[PWR] P0.%u  HIGH=0x%02X  LOW=0x%02X", P, idH, idL);
        if (idH == 0x6A || idL == 0x6A)
        {
            NRF_LOG_INFO(">>> [PWR] FOUND! 전원핀 = P0.%u", P);
        }
        nrf_delay_ms(3);
    }
    NRF_LOG_INFO("[PWR] 완료");
}

static void lsm6_exhaustive(void)
{
    static const uint8_t sck[]  = {17, 27, 40};
    static const uint8_t mosi[] = {13, 15, 26, 39};
    static const uint8_t miso[] = {6, 15, 26, 37, 39, 40};
    static const uint8_t cs[]   = {8, 19, 25, 36, 38, 39, 43};
    uint32_t tried = 0;

    /* 전원 제어선은 건드리지 않는다. */
    nrf_gpio_cfg_output(14);
    nrf_gpio_pin_clear(14);
    NRF_LOG_INFO("[SCAN] restricted SPI exhaustive scan started");

    for (uint32_t a = 0; a < sizeof(sck); a++)
    for (uint32_t b = 0; b < sizeof(mosi); b++)
    for (uint32_t c = 0; c < sizeof(miso); c++)
    for (uint32_t d = 0; d < sizeof(cs); d++)
    {
        if (sck[a] == mosi[b] || sck[a] == miso[c] || sck[a] == cs[d] ||
            mosi[b] == miso[c] || mosi[b] == cs[d] || miso[c] == cs[d])
            continue;
        for (uint8_t mode = 0; mode < 2; mode++)
        {
            nrf_drv_spi_mode_t m = mode ? NRF_DRV_SPI_MODE_0 : NRF_DRV_SPI_MODE_3;
            uint8_t id = spi_read_whoami(sck[a], mosi[b], miso[c], cs[d], m);
            tried++;
            if (id == 0x6A)
                NRF_LOG_INFO(">>> FOUND SCK=%u MOSI=%u MISO=%u CS=%u mode=%u",
                             sck[a], mosi[b], miso[c], cs[d], mode ? 0 : 3);
        }
    }
    NRF_LOG_INFO("[SCAN] finished combinations=%u", tried);
}

int main(void)
{
    /* ISP1807의 nRF52840 Rev3는 구형 SDK에서 부팅 시 APPROTECT가
     * 자동 활성화될 수 있다. 개발/RTT 진단 중에는 소프트웨어 해제한다. */
    *((volatile uint32_t *)0x40000558UL) = 0x5A;

    bool erase_bonds;

    // Initialize.
    // uart_init();   // UART 끔: P0.06(MISO) 등 센서 핀을 UART가 점유하지 않도록
    log_init();
    timers_init();
    buttons_leds_init(&erase_bonds);
    power_management_init();
    ble_stack_init();
    gap_params_init();
    gatt_init();
    services_init();
    advertising_init();
    conn_params_init();

    // Start execution.
    // printf("\r\nUART started.\r\n");   // UART 껐으므로 제거
    NRF_LOG_INFO("Debug logging for UART over RTT started.");
    advertising_start();

    // IMU(LSM6DSL) 초기화 — 전원 ON + WHO_AM_I 확인 + ODR 설정
    lsm6_init();

    // Enter main loop.
    for (;;)
    {
        if (m_sample_due)
        {
            m_sample_due = false;
            // 실제 센서 읽기는 메인 루프(thread 모드)에서 수행 (ISR 블로킹 방지)
            if (m_recording && (m_log_count < LOG_BUF_SIZE))
            {
                lsm6_read_sample(&m_log_buf[m_log_count]);
                m_log_count++;
                if (m_log_count >= LOG_BUF_SIZE)
                {
                    m_recording = false;   // 버퍼가 꽉 차면 자동 정지
                    NRF_LOG_INFO("Buffer full (%d samples). Recording auto-stopped.", m_log_count);
                }
            }
        }
        if (m_dump_request)
        {
            m_dump_request = false;
            log_dump_over_ble();   // 정지 신호로 요청된 데이터 전송 실행
        }
        if (m_scan_request)
        {
            m_scan_request = false;
            scan_dump_over_ble();  // 'w' 명령으로 요청된 센서 스캔 실행 + BLE 전송
        }
        idle_state_handle();
    }
}


